
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f1f5f9;
  color: #172033;
  line-height: 1.6;
}

header {
  background: #123b70;
  color: white;
  text-align: center;
  padding: 28px 15px;
}

header h1 {
  margin: 0;
  font-size: 28px;
}

header p {
  margin-bottom: 0;
}

main {
  width: 92%;
  max-width: 600px;
  margin: 25px auto;
}

section {
  background: white;
  padding: 22px;
  margin-bottom: 20px;
  border-radius: 14px;
  box-shadow: 0 3px 12px #00000010;
}

h2 {
  color: #123b70;
  margin-top: 0;
}

label {
  display: block;
  margin-top: 14px;
  font-weight: bold;
}

input {
  display: block;
  width: 100%;
  padding: 13px;
  margin-top: 6px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 16px;
}

button {
  width: 100%;
  padding: 13px;
  margin-top: 12px;
  border: none;
  border-radius: 8px;
  background: #1558a6;
  color: white;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #0d3e78;
}

#signup-btn {
  background: #15803d;
}

#logout-btn {
  background: #b91c1c;
}

#auth-message,
#app-message {
  overflow-wrap: anywhere;
}

.election-card,
.candidate-card {
  border: 1px solid #dbe3ee;
  border-radius: 10px;
  padding: 14px;
  margin-top: 14px;
}

footer {
  text-align: center;
  color: #64748b;
  padding: 15px;
  font-size: 14px;
}

[hidden] {
  display: none !important;
}
